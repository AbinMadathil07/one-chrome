CHROME_MCP_HOST=127.0.0.1
CHROME_MCP_PORT=12306
CHROME_MCP_BRIDGE_PORT=12307
CHROME_MCP_TOKEN=
CHROME_MCP_MAX_SESSIONS=16
CHROME_MCP_MAX_TABS_PER_SESSION=8
CHROME_MCP_LEASE_TTL_MS=120000
CHROME_MCP_COMMAND_TIMEOUT_MS=60000
CHROME_MCP_IDLE_SESSION_TTL_MS=1800000
CHROME_MCP_ALLOW_SHARED_TABS=true
# Restrict uploads (and Claude document_ids) to one directory. Empty = any absolute path.
CHROME_MCP_UPLOAD_DIR=
# Comma-separated host allowlist for navigation, e.g. "*.example.com,docs.test". Empty = any host.
CHROME_MCP_ALLOWED_HOSTS=
CHROME_MCP_BLOCK_PRIVATE_NETWORKS=false
CHROME_MCP_SCREENSHOT_MAX_EDGE=1568
# Hide tools from every endpoint, e.g. "javascript_exec,file_upload,chrome_evaluate".
CHROME_MCP_DISABLED_TOOLS=
