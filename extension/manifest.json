{
  "manifest_version": 3,
  "name": "Chrome MCP Bridge",
  "description": "Connects your real Chrome browser to the chrome-mcp host for multi-model automation.",
  "version": "2.2.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Chrome MCP Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "debugger",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
